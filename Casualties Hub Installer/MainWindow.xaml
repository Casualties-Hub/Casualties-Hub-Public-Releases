<Window x:Class="Casualties_Hub_Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Casualties Hub Setup Wizard"
        Width="920" Height="670" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#202225"
        Foreground="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#303238" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#44474E" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#17181A" />
        <SolidColorBrush x:Key="CrimsonBrush" Color="#C21F32" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#E7E7E7" />
            <Setter Property="Foreground" Value="#151515" />
            <Setter Property="BorderBrush" Value="#A9A9A9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CFCFCF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CrimsonBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#E45465" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="24,10" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7D1F2B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B44454" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#23252A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#5A5D65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="7,3" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" Padding="30,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/CasualtiesHub.png" Width="58" Height="58" Margin="0,0,18,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="29" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                        <Run Text="Casualties " /><Run Text="Hub" Foreground="{StaticResource CrimsonBrush}" />
                    </TextBlock>
                    <TextBlock Text="Setup Wizard" Foreground="#C7C9CE" FontSize="15" Margin="1,2,0,0" />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"
                        Background="#24262B" BorderBrush="#464951" BorderThickness="1" Padding="12,7">
                    <TextBlock Text="OFFICIAL GITHUB SETUP WIZARD" Foreground="#D9D9D9" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,26,30,30" MaxWidth="1080" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Install, update, or remove Casualties Hub" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Choose a published official GitHub release and a Hub folder. This Setup Wizard does not touch Casualties Unknown, mods, saves, or protected assets."
                               Foreground="#D0D2D7" TextWrapping="Wrap" Margin="0,7,0,22" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Official release" FontWeight="SemiBold" FontSize="17" />
                                <TextBlock x:Name="ReleaseCountText" Text="Loading available releases..." Foreground="#B9D7FF" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="RefreshVersionsButton" Grid.Column="1" Content="Refresh versions" Click="RefreshVersions_Click" Margin="18,0,0,0" />

                            <CheckBox x:Name="IncludePrereleasesCheckBox" Grid.Row="1" Grid.ColumnSpan="2"
                                      Content="Include Pre-Release builds (testing builds; install at your own risk)"
                                      Foreground="#E1E1E1" Margin="0,16,0,10"
                                      Checked="IncludePrereleasesChanged" Unchecked="IncludePrereleasesChanged" />

                            <ComboBox x:Name="ReleaseComboBox" Grid.Row="2" Grid.ColumnSpan="2" DisplayMemberPath="Tag"
                                      ToolTip="Published GitHub releases only" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Install location" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Grid.Row="1" Text="The selected Hub folder is safe to update; unrelated files are left in place."
                                       Foreground="#C7C9CE" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathTextBox" ToolTip="Where Casualties Hub will be installed" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="Browse_Click" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="InstalledVersionText" Grid.Row="3" Foreground="#B9D7FF" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detected Hub installations" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" />
                                <Button x:Name="DetectInstallationsButton" Grid.Column="1" Content="Detect installations" Click="DetectInstallations_Click" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Click an installation to use its folder for an update. Tick the copies you want to remove; the Wizard only removes the exact Hub folders you select."
                                       Foreground="#C7C9CE" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SelectAllInstallationsButton" Content="Select all" Click="SelectAllInstallations_Click" />
                                <Button x:Name="ClearInstallationSelectionButton" Grid.Column="1" Content="Clear" Click="ClearInstallationSelection_Click" Margin="10,0,0,0" />
                                <CheckBox x:Name="DeleteHubDataCheckBox" Grid.Column="2"
                                          Foreground="#FFB8C0" Margin="18,0,0,0" VerticalAlignment="Center" Checked="DeleteHubDataChanged" Unchecked="DeleteHubDataChanged">
                                    <TextBlock Text="Also delete Hub data, logs, cache, settings, and Protected Assets (full removal)" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button x:Name="UninstallButton" Grid.Column="3" Style="{StaticResource DangerButton}" Content="Remove selected" Click="Uninstall_Click" Margin="12,0,0,0" IsEnabled="False" />
                            </Grid>
                            <Grid Grid.Row="3">
                                <ListBox x:Name="KnownInstallationsList" MaxHeight="172" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         Background="#24262B" BorderBrush="#4A4D55" Foreground="White" SelectionChanged="KnownInstallationsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" Click="InstallationCheckBox_Click" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Version}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Path}" Foreground="#C7C9CE" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="KnownInstallationsEmptyText" Text="No Casualties Hub installations were found in the usual locations. Choose a folder manually or use Detect installations again."
                                           Foreground="#A8ABB2" FontStyle="Italic" TextWrapping="Wrap" Margin="12,8"
                                           IsHitTestVisible="False" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="#292B30" BorderBrush="#4A4D55" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="LaunchAfterInstallCheckBox" IsChecked="True" Content="Launch Casualties Hub after installation" Foreground="White" />
                                <TextBlock Text="The installer will close nothing automatically before you confirm the installation."
                                           Foreground="#C7C9CE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="Install / update Hub" Click="Install_Click" Margin="20,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="BusyProgress" Width="86" Height="5" IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="White" Text="Loading official releases..."
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock Grid.Column="2" Text="Wizard 0.0-pre.1" Foreground="#D0D2D7" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
