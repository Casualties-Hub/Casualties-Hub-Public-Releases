<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Casualties_Hub.Views.SkinsPage">

  <Grid ColumnDefinitions="*,360">

    <DockPanel Grid.Column="0" Margin="0,0,16,0">

      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="CustomSprites skins"/>
          <TextBlock x:Name="RootPathText" Classes="dim" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshButton" Content="Refresh"/>
            <Button x:Name="OpenFolderButton" Content="Open folder"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Classes="muted"
                 TextWrapping="Wrap" Margin="2,0,0,12"/>

      <ScrollViewer>
        <ItemsControl x:Name="SlotList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="raised" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SpriteSummary}" Classes="muted"/>
                    <TextBlock Text="{Binding MissingSummary}"
                               IsVisible="{Binding HasMissing}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Preview" Tag="{Binding}" Click="OnPreview"
                          VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

    <Border Grid.Column="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Preview" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
          <TextBlock x:Name="PreviewSlotText" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock x:Name="MissingSpriteText" Classes="dim" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}" IsVisible="False"/>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Head" Classes="dim" VerticalAlignment="Center"/>
            <ComboBox x:Name="HeadBox" Grid.Column="1" HorizontalAlignment="Stretch"/>
          </Grid>
          <Grid ColumnDefinitions="70,*">
            <TextBlock Grid.Column="0" Text="Eyes" Classes="dim" VerticalAlignment="Center"/>
            <ComboBox x:Name="EyeBox" Grid.Column="1" HorizontalAlignment="Stretch"/>
          </Grid>
          <Grid ColumnDefinitions="70,*,44">
            <TextBlock Grid.Column="0" Text="Zoom" Classes="dim" VerticalAlignment="Center"/>
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="16" Value="6"
                    VerticalAlignment="Center"/>
            <TextBlock x:Name="ZoomLabel" Grid.Column="2" Classes="dim" VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TurnAroundButton" Content="Turn around"
                    ToolTip.Tip="Mirror the pose. The same art is flipped; there is no separate back-facing sprite set."/>
            <Button x:Name="ReturnToCentreButton" Content="Centre"
                    ToolTip.Tip="Reset zoom and scroll position."/>
          </StackPanel>
        </StackPanel>

        <!--
          The zoom slider drives an explicit scale rather than letting the Viewbox stretch to fill,
          so pixel art sits at a whole-number multiple and stays sharp. The ScrollViewer is what
          makes panning possible once the zoomed art is larger than the panel.
        -->
        <Border Background="{DynamicResource InsetBrush}" CornerRadius="4" Padding="10">
          <ScrollViewer x:Name="PreviewScroller"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Viewbox x:Name="PreviewHost" Stretch="Uniform" StretchDirection="Both"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>

  </Grid>

</UserControl>
