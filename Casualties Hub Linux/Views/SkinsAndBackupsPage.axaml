<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Casualties_Hub.Views.SkinsAndBackupsPage">

  <DockPanel>
    <!--
      Sections are switched here rather than laid out side by side, because the skin preview needs
      the full width to be legible.
    -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,14">
      <Button x:Name="SkinsTab" Content="Skin Preview"/>
      <Button x:Name="ProtectedTab" Content="Protected Assets"/>
      <Button x:Name="BackupsTab" Content="Backups"/>
    </StackPanel>

    <ContentControl x:Name="SectionHost"/>
  </DockPanel>

</UserControl>
