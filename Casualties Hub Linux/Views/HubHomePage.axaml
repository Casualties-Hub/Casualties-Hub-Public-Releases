<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Casualties_Hub.Views.HubHomePage">

  <ScrollViewer>
    <StackPanel Spacing="16">

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="Announcement"/>
          <TextBlock x:Name="AnnouncementText" TextWrapping="Wrap"/>
          <TextBlock x:Name="ServiceStatusText" Classes="dim" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="CheckButton" Content="Check now"/>
            <Button x:Name="HistoryButton" Content="Previous announcements"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="HistoryCard" Classes="card" IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="Previous announcements"/>
          <TextBlock x:Name="NoHistoryText" Classes="muted" Text="No earlier announcements have been seen yet."/>
          <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="raised" Margin="0,0,0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PublishedAtUtc}" Classes="dim"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="What changed in this build"/>
          <TextBlock x:Name="VersionText" Classes="muted"/>
          <TextBlock x:Name="WhatChangedText" TextWrapping="Wrap"/>
          <Button x:Name="ReleaseInfoButton" Content="Release information" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          <TextBlock x:Name="ReleaseInfoText" IsVisible="False" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="Links"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ReleasesButton" Content="Release history"/>
            <Button x:Name="NexusButton" Content="Nexus page"/>
            <Button x:Name="DiscordButton" Content="Discord"/>
            <Button x:Name="CreditsButton" Content="Credits"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
