<Window x:Class="Casualties_Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Casualties Hub - 100% Vibe coded by MarlyZ89"
        Width="1280" Height="800" MinWidth="1180" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        >
    <Window.Resources>
        <!-- Sidebar entries are pills rather than plain buttons: a status dot, a
             left-aligned label, and an accent tint when the page is open. The dot
             follows Foreground so SetActiveNavigation only has to set two
             properties and the whole pill stays in step with the player's accent. -->
        <Style x:Key="NavPillStyle" TargetType="{x:Type Button}">
            <!-- Clicking a pill focuses it, and WPF's stock focus adorner draws a
                 dashed rectangle over the rounded edge. The accent wash already
                 shows which page is open, so the adorner is suppressed. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Pill" CornerRadius="11" Background="{TemplateBinding Background}" Padding="14,0"
                                BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{TemplateBinding Foreground}"/>
                                <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <!-- Sidebar runs the full height, so the top bar belongs to the content area only. -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource ChromeBrush}" Panel.ZIndex="30"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,26,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The wordmark is branding, not themed text. Both Runs are hard-coded
                     so no UI preset, custom colour, or Animated RGB can repaint it, and
                     ApplyPrimaryTextColour cannot touch a Run that sets its own brush. -->
                <TextBlock x:Name="Wordmark" Grid.Row="0" FontSize="22" FontWeight="Bold" Margin="8,0,0,28">
                    <Run Text="Casualties" Foreground="#FFFFFFFF"/><Run Text=" " Foreground="#FFFFFFFF"/><Run Text="Hub" Foreground="#FFC81E3C"/>
                </TextBlock>

                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardNavButton" Content="Nexus Dashboard" Style="{StaticResource NavPillStyle}" Click="Dashboard_Click"/>
                    <Button x:Name="ModsNavButton" Content="Local Mods" Style="{StaticResource NavPillStyle}" Click="Mods_Click"/>
                    <Button x:Name="MultiplayerNavButton" Content="Multiplayer" Style="{StaticResource NavPillStyle}" Click="Multiplayer_Click"
                            ToolTip="Server browser preview. Not connected to a live service yet."/>
                    <Button x:Name="SkinsAndBackupsNavButton" Content="Skins &amp; Backups" Style="{StaticResource NavPillStyle}" Click="SkinsAndBackups_Click"
                            ToolTip="Keep copies of files a mod update would overwrite, and preview the character skins installed through CustomSprites."/>
                    <!-- Credits now lives inside Hub Home, keeping the sidebar compact. -->
                    <Button x:Name="HubHomeNavButton" Content="Hub Home" Style="{StaticResource NavPillStyle}" Click="HubHome_Click"/>
                    <Button x:Name="SettingsNavButton" Content="Settings" Style="{StaticResource NavPillStyle}" Click="Settings_Click"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,14,10,0">
                    <TextBlock x:Name="SidebarFooterText" Text="v0.0.8-pre.6" FontSize="11.5"
                               Foreground="{DynamicResource DimTextBrush}" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}" Panel.ZIndex="20"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="36,0">
                <Button x:Name="LaunchGameButton" Content="Launch game" Width="320" Height="46"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentSoftTextBrush}" BorderBrush="{DynamicResource AccentSoftTextBrush}"
                        FontSize="16" FontWeight="Bold"
                        ToolTip="Launch Casualties Unknown through Steam" Click="LaunchGame_Click"/>
                <Button Content="Report issues" Width="130" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Open the Casualties Hub report and issue forum" Click="ReportIssues_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}"><Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource WindowBackgroundBrush}"/></Border>

        <Border x:Name="StatusBarHost" Grid.Row="2" Grid.Column="1" Background="{DynamicResource ChromeBrush}" Panel.ZIndex="20" ClipToBounds="True">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="36,0,16,0" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid x:Name="PapaZuck" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="40" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,54" Cursor="Hand" ToolTip="PapaZuck, unofficial/official Casualties Hub mascot. Click 3 times to pop; 5 times for a surprise." MouseLeftButtonUp="PapaZuck_Click" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="PapaZuckScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Canvas><Image Source="pack://application:,,,/Assets/PapaZuck.png" Width="150" Height="150" Stretch="Uniform"/></Canvas>
        </Grid>
    </Grid>
</Window>
