<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Casualties_Hub</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\CasualtiesHub.ico</ApplicationIcon>
    <Version>0.0.8-pre.4</Version>
    <AssemblyVersion>0.0.8.0</AssemblyVersion>
    <FileVersion>0.0.8.0</FileVersion>
    <InformationalVersion>0.0.8-pre.4</InformationalVersion>
  </PropertyGroup>

  <!-- Release publishing intentionally produces one self-contained EXE. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="Helpers\" />
    <Folder Include="View Models\" />
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PapaZuck.png" />
    <Resource Include="Assets\CasualtiesHub.png" />
    <Resource Include="Assets\CreditMeow.jpg" />
    <Resource Include="Assets\CreditExp3238.png" />
    <Resource Include="Assets\CreditYou1Are0Ic.png" />
    <Resource Include="Assets\CreditMarly.png" />
  </ItemGroup>

  <!--
    Catalogs, Hub content, and release notes travel inside the EXE so a release can ship as a
    single file. BundledData still prefers a matching file under Data\ beside the Hub, which
    keeps the catalogs hand-editable on an unpacked install.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Services\DependencyCatalog.json">
      <LogicalName>Bundled/Catalogs/DependencyCatalog.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Services\IncompatibilityCatalog.json">
      <LogicalName>Bundled/Catalogs/IncompatibilityCatalog.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\HubContent.json">
      <LogicalName>Bundled/HubContent.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Release Notes\*.txt">
      <LogicalName>Bundled/Release Notes/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>
