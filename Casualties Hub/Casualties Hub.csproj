<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Casualties_Hub</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\CasualtiesHub.ico</ApplicationIcon>
    <Version>0.0.6-pre.10.2</Version>
    <AssemblyVersion>0.0.6.102</AssemblyVersion>
    <FileVersion>0.0.6.102</FileVersion>
    <InformationalVersion>0.0.6-pre.10.2</InformationalVersion>
  </PropertyGroup>

  <!-- Release publishing intentionally produces one self-contained EXE. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="Helpers\" />
    <Folder Include="View Models\" />
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PapaZuck.png" />
    <Resource Include="Assets\CasualtiesHub.png" />
    <Resource Include="Assets\CreditMeow.jpg" />
    <Resource Include="Assets\CreditExp3238.png" />
    <Resource Include="Assets\CreditYou1Are0Ic.png" />
    <Resource Include="Assets\CreditMarly.png" />
    <Content Include="Services\DependencyCatalog.json">
      <Link>Data\Catalogs\DependencyCatalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Services\IncompatibilityCatalog.json">
      <Link>Data\Catalogs\IncompatibilityCatalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Developer Console.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="00 - READ ME FIRST.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Release Notes\*.txt">
      <Link>Data\Release Notes\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>
