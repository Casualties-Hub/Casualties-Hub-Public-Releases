<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Casualties_Hub.App"
             RequestedThemeVariant="Dark">

  <!-- Theming is split per control under Themes\ so one control can be reworked in isolation. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://casualties-hub/Themes/Brushes.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://casualties-hub/Themes/Controls.axaml"/>
  </Application.Styles>

</Application>
