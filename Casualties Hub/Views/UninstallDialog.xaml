<Window x:Class="Casualties_Hub.Views.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Casualties Hub"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#2B2D31">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Uninstall Casualties Hub" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#DCE0E5"
                   Text="Choose what to remove. The Hub will close, then finish deleting the selected items after it exits. This cannot be undone."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,6">
            <TextBlock Text="What to remove" Foreground="#C9CDD3" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="SelectAllButton" Content="Select all" Width="90" Height="24" Margin="12,0,0,0" Click="SelectAllButton_Click"/>
            <Button x:Name="SelectNoneButton" Content="Select none" Width="100" Height="24" Margin="8,0,0,0" Click="SelectNoneButton_Click"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="12">
            <StackPanel x:Name="ItemsPanel"/>
        </Border>

        <TextBlock x:Name="WarningText" Grid.Row="4" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#F2A93B" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="Type DELETE to confirm." Foreground="#C9CDD3" Margin="0,0,0,6"/>
            <TextBox x:Name="ConfirmationBox" Background="#292B30" Foreground="White" BorderBrush="#555A63" Padding="8" TextChanged="ConfirmationBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" Height="34" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="UninstallButton" Content="Uninstall" Width="140" Height="34" Background="#B71C2A" Foreground="White" IsEnabled="False" Click="Uninstall_Click"/>
        </StackPanel>
    </Grid>
</Window>
