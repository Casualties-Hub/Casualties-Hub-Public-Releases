<Page x:Class="Casualties_Hub.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:Casualties_Hub.Helpers"
      Background="{DynamicResource WindowBackgroundBrush}">
    <Page.Resources>
        <!-- Dashboard cards intentionally do not use the global hover-tooltip rule. -->
        <Style TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{x:Null}"/>
            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        </Style>
        <!-- The same two buttons repeat on every one of ~300 cards, so a normal
             delay makes tooltips fire constantly while scanning the grid. They
             only appear if you actually settle on a button. -->
        <Style TargetType="Button" BasedOn="{StaticResource HubButtonStyle}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="1200"/>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Border x:Name="GameFolderCard" Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Game folder" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="GamePathText" Text="Not configured" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <Button Content="Choose game folder" Width="170" HorizontalAlignment="Left" Click="ChooseGameFolder_Click" ToolTip="Pick the Casualties Unknown game folder, its BepInEx folder, or the Plugins folder. The Hub works out the rest."/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,20,0,12">
                <TextBox x:Name="SearchBox" Width="240" Height="32" Margin="0,0,10,8" Padding="8,5" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" TextChanged="FiltersChanged" ToolTip="Search mod name or author" helpers:TextBoxExtras.Placeholder="Mod search" helpers:TextBoxExtras.ShowClearButton="True"/>
                <ComboBox x:Name="SortBox" Width="190" Height="32" Margin="0,0,10,8" SelectionChanged="FiltersChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Total downloads ↓"/>
                    <ComboBoxItem Content="Total downloads ↑"/>
                    <ComboBoxItem Content="Unique downloads ↓"/>
                    <ComboBoxItem Content="Endorsements ↓"/>
                    <ComboBoxItem Content="Date ↓"/>
                    <ComboBoxItem Content="Name A-Z"/>
                </ComboBox>
                <CheckBox x:Name="HideInstalledBox" Content="Hide installed mods" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,8" Checked="FiltersChanged" Unchecked="FiltersChanged"/>
                <TextBlock Text="Installed:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,8"/>
                <TextBlock x:Name="ModCountText" Text="0" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <CheckBox x:Name="AdultContentBox" Content="18+" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,8" Checked="FiltersChanged" Unchecked="FiltersChanged" ToolTip="Include mods flagged as adult content on Nexus in this list."/>
                <Button Content="Refresh" Width="95" Height="32" Margin="0,0,10,8" Click="RefreshMetadata_Click" ToolTip="Re-download the community mod metadata from Nexus."/>
            </WrapPanel>

            <TextBlock x:Name="MetadataStatusText" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <ItemsControl x:Name="MetadataModsList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="270" Height="495" CornerRadius="16" Margin="0,0,14,14" Padding="12" MouseLeftButtonUp="ShowModDescription_Click" Cursor="Hand"
                                Background="{DynamicResource CardBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Every card keeps the same surface. State is marked by the
                                         card's edge and its status line instead of a tinted card,
                                         which reads far better on the dark shell. The out-of-date
                                         trigger is listed last so it wins over the installed one. -->
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocallyInstalled}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3F6B4A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLocallyOutOfDate}" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8842F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="{DynamicResource ChromeBrush}" CornerRadius="4"><Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/></Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="{Binding Author}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="3" Text="{Binding TotalDownloadsLabel}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="4" Text="{Binding UniqueDownloadsLabel}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="5" Text="{Binding EndorsementsLabel}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="6" Text="{Binding Version, StringFormat=Version {0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="7" Text="{Binding FileSizeLabel}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="8" Text="{Binding DependenciesLabel}" Foreground="#5DB8FF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="9" Text="{Binding LocalStatusLabel}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocallyInstalled}" Value="True">
                                                    <Setter Property="Foreground" Value="#67E480"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLocallyOutOfDate}" Value="True">
                                                    <Setter Property="Foreground" Value="#F1C453"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Row="11">
                                    <Button Content="{Binding DashboardActionLabel}" Tag="{Binding}" Click="DownloadOrOpenNexusFiles_Click" Height="30" ToolTip="Opens this mod's Nexus files page in your browser. With a Premium API key saved in Settings the download starts directly instead."/>
                                    <Button Content="View Modpage" Tag="{Binding}" Click="ViewNexusModPage_Click" Height="30" Margin="0,6,0,0" ToolTip="Opens the mod's main Nexus page in your browser for the description, images, and comments."/>
                                </StackPanel>
                                <Border Grid.RowSpan="12" Background="{DynamicResource InsetBrush}" Padding="12" Panel.ZIndex="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Description" Foreground="#5DB8FF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ScrollViewer Height="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding RenderedDescription}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </ScrollViewer>
                                        <TextBlock Text="Click the card again to return to the mod details." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                <Button Content="Previous" Width="100" Click="PreviousPage_Click"/>
                <TextBlock x:Name="PageText" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="16,0"/>
                <Button Content="Next" Width="100" Click="NextPage_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
