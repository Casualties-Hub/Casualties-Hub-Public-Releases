<Page x:Class="Casualties_Hub.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#2B2D31">
    <Page.Resources>
        <!-- Dashboard cards intentionally do not use the global hover-tooltip rule. -->
        <Style TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{x:Null}"/>
            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Border x:Name="GameFolderCard" Background="#36393F" Padding="20" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Game folder" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="GamePathText" Text="Not configured" Foreground="#C9CDD3" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <Button Content="Choose game folder" Width="170" HorizontalAlignment="Left" Click="ChooseGameFolder_Click"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,20,0,12">
                <Grid Width="240" Height="32" Margin="0,0,10,8">
                    <TextBox x:Name="SearchBox" Padding="8,5" Background="#36393F" Foreground="White" BorderBrush="#555A63" TextChanged="FiltersChanged" ToolTip="Search mod name or author"/>
                    <TextBlock Text="Mod search" Foreground="#7F8791" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox x:Name="SortBox" Width="190" Height="32" Margin="0,0,10,8" SelectionChanged="FiltersChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Total downloads ↓"/>
                    <ComboBoxItem Content="Total downloads ↑"/>
                    <ComboBoxItem Content="Unique downloads ↓"/>
                    <ComboBoxItem Content="Endorsements ↓"/>
                    <ComboBoxItem Content="Date ↓"/>
                    <ComboBoxItem Content="Name A-Z"/>
                </ComboBox>
                <CheckBox x:Name="HideInstalledBox" Content="Hide installed mods" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,8" Checked="FiltersChanged" Unchecked="FiltersChanged"/>
                <TextBlock Text="Installed:" Foreground="#C9CDD3" VerticalAlignment="Center" Margin="0,0,4,8"/>
                <TextBlock x:Name="ModCountText" Text="0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <CheckBox x:Name="AdultContentBox" Content="18+" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,8" Checked="FiltersChanged" Unchecked="FiltersChanged" ToolTip="Show adult mods"/>
                <Button Content="Refresh" Width="95" Height="32" Margin="0,0,10,8" Click="RefreshMetadata_Click"/>
            </WrapPanel>

            <TextBlock x:Name="MetadataStatusText" Foreground="#C9CDD3" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <ItemsControl x:Name="MetadataModsList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="270" Height="495" CornerRadius="6" Margin="0,0,14,14" Padding="12" MouseLeftButtonUp="ShowModDescription_Click" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#36393F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocallyInstalled}" Value="True">
                                            <Setter Property="Background" Value="#39483D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="#202225" CornerRadius="4"><Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/></Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="{Binding Author}" Foreground="#C9CDD3" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="3" Text="{Binding TotalDownloadsLabel}" Foreground="#A9AFB8" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="4" Text="{Binding UniqueDownloadsLabel}" Foreground="#A9AFB8" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="5" Text="{Binding EndorsementsLabel}" Foreground="#A9AFB8" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="6" Text="{Binding Version, StringFormat=Version {0}}" Foreground="#A9AFB8" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="7" Text="{Binding FileSizeLabel}" Foreground="#A9AFB8" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="8" Text="{Binding DependenciesLabel}" Foreground="#5DB8FF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="9" Text="{Binding LocalStatusLabel}" Foreground="#C9CDD3" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <StackPanel Grid.Row="11">
                                    <Button Content="{Binding DashboardActionLabel}" Tag="{Binding}" Click="DownloadOrOpenNexusFiles_Click" Height="30"/>
                                    <Button Content="View Modpage" Tag="{Binding}" Click="ViewNexusModPage_Click" Height="30" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.RowSpan="12" Background="#24262B" Padding="12" Panel.ZIndex="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Description" Foreground="#5DB8FF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ScrollViewer Height="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding RenderedDescription}" Foreground="#E0E3E8" TextWrapping="Wrap" LineHeight="18"/>
                                        </ScrollViewer>
                                        <TextBlock Text="Click the card again to return to the mod details." Foreground="#A9AFB8" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                <Button Content="Previous" Width="100" Click="PreviousPage_Click"/>
                <TextBlock x:Name="PageText" Foreground="White" VerticalAlignment="Center" Margin="16,0"/>
                <Button Content="Next" Width="100" Click="NextPage_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
