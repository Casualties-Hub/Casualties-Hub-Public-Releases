<Page x:Class="Casualties_Hub.Views.CreditsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#2B2D31">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="32" MaxWidth="1185">
            <!-- Square cards deliberately reserve the upper section for name, role, and contribution. -->
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="MarlyZ89" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Project Creator" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Creator of Casualties Hub &amp; Casualties Setup Wizard" Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Image Grid.Row="1" Source="pack://application:,,,/Assets/CreditMarly.png" Stretch="UniformToFill"/></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="JimmyKing" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Core Library Developer" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Creator of Nexus Metadata, QoLUnknown, and CUCoreLib" Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="#292B30"><TextBlock Text="Contributor image coming soon" Foreground="#838A94" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></Border></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="EXP-3238" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Founding Tester" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Tested private builds before the first public release. Creator of the &quot;Get Zucked&quot; easter egg." Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Image Grid.Row="1" Source="pack://application:,,,/Assets/CreditExp3238.png" Stretch="UniformToFill"/></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="YOU1ARE0IC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Community Contributor" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Creator of PapaZuck" Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Image Grid.Row="1" Source="pack://application:,,,/Assets/CreditYou1Are0Ic.png" Stretch="UniformToFill"/></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="Linda" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pre-Alpha Tester" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Official bug tester for private pre-alpha builds." Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="#292B30"><TextBlock Text="Contributor image coming soon" Foreground="#838A94" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></Border></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="Ares v3.2" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pre-Alpha Tester" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Official bug tester for private pre-alpha builds." Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="#292B30"><TextBlock Text="Contributor image coming soon" Foreground="#838A94" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></Border></Grid></Border>
            <Border Background="#36393F" CornerRadius="7" Width="280" Height="280" Margin="0,0,16,16" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,12,14,10"><TextBlock Text="Storm Shirogane" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pre-Alpha Tester" Foreground="#C21F32" Margin="0,3,0,0" FontWeight="SemiBold"/><TextBlock Text="Official bug tester for private pre-alpha builds." Foreground="#C9CDD3" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="#292B30"><TextBlock Text="Contributor image coming soon" Foreground="#838A94" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></Border></Grid></Border>
        </WrapPanel>
    </ScrollViewer>
</Page>
