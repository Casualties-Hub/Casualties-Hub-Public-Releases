<Page x:Class="Casualties_Hub.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Game location" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the Casualties Unknown game folder, BepInEx folder, or Plugins folder." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <TextBox x:Name="GamePathBox" IsReadOnly="True" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8"/>
                    <Button Content="Change game folder" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChangeFolder_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Download inbox" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="New mod archives in this folder can be detected and offered for installation." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <TextBox x:Name="DownloadPathBox" IsReadOnly="True" Background="{DynamicResource InsetBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Change download inbox" Width="185" Click="ChangeDownloadFolder_Click"/>
                        <CheckBox x:Name="DadipfBox" Content="Keep imported downloads" Foreground="{DynamicResource PrimaryTextBrush}" Margin="16,4,0,0" ToolTip="Keep imported archives in the download inbox instead of moving them into Hub storage." Checked="DadipfBox_Changed" Unchecked="DadipfBox_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Accessibility" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Text size" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,6"/>
                    <ComboBox x:Name="TextSizeBox" Width="180" HorizontalAlignment="Left" SelectionChanged="TextSizeBox_Changed"
                              Foreground="{DynamicResource ControlTextBrush}" Background="{DynamicResource ControlSurfaceBrush}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Small (12)" Tag="12"/>
                        <ComboBoxItem Content="Normal (14)" Tag="14"/>
                        <ComboBoxItem Content="Large (16)" Tag="16"/>
                        <ComboBoxItem Content="Extra Large (18)" Tag="18"/>
                        <ComboBoxItem Content="Maximum (20)" Tag="20"/>
                    </ComboBox>
                    <ToggleButton x:Name="EasterEggsToggle" Content="Easter Eggs" Width="115" Height="28" HorizontalAlignment="Left" Margin="0,12,0,0" Checked="EasterEggsToggle_Changed" Unchecked="EasterEggsToggle_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
                                <Setter Property="BorderBrush" Value="#3F3F3F"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="UI presets" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,16,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActivePresetText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Default" Tag="Default" Width="120" Height="30" Margin="0,0,8,0" Click="ApplyUiPreset_Click" ToolTip="Replace the current colours with the stock Casualties Hub set."/>
                        <Button x:Name="AnimatedRgbButton" Content="Animated RGB" Tag="AnimatedRgb" Width="150" Height="30" Click="ApplyUiPreset_Click" ToolTip="Cycles the accent colour through the spectrum, so buttons and highlights animate. Text is left alone. Press again to turn it off; your colours come straight back."/>
                        <Button x:Name="CustomColoursButton" Content="Custom…" Width="120" Height="30" Margin="8,0,0,0" Click="ToggleCustomColours_Click" ToolTip="Pick your own colour for the background, panels, text, or accent."/>
                    </StackPanel>
                    <Border x:Name="CustomColourPanel" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,0,12" MaxWidth="400"
                            HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel>
                            <ComboBox x:Name="ColourTargetBox" SelectedIndex="0" Height="30" SelectionChanged="ColourTarget_Changed"
                                      ToolTip="Which part of the interface this colour applies to.">
                                <ComboBoxItem Content="Accent (buttons &amp; highlights)" Tag="Accent"/>
                                <ComboBoxItem Content="Background" Tag="Background"/>
                                <ComboBoxItem Content="Panels &amp; cards" Tag="Surface"/>
                                <ComboBoxItem Content="Text" Tag="Text"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <!-- The slot shows the colour as it stands. Pressing it swaps in
                                     the wheel: hue around the circle, saturation outward from the
                                     middle. Brightness appears with the wheel, because a flat wheel
                                     cannot reach the near-black tones the shell uses. -->
                                <Grid Width="86" Height="86" VerticalAlignment="Top">
                                    <Ellipse x:Name="ColourSwatch" Width="78" Height="78" Cursor="Hand"
                                             Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="2"
                                             MouseLeftButtonUp="ColourSwatch_Click"
                                             ToolTip="The colour in use now. Click to open the colour wheel."/>
                                    <Image x:Name="ColourWheelImage" Width="86" Height="86" Cursor="Cross" Visibility="Collapsed"
                                           MouseLeftButtonDown="ColourWheel_MouseDown"
                                           MouseMove="ColourWheel_MouseMove"
                                           MouseLeftButtonUp="ColourWheel_MouseUp"
                                           ToolTip="Click or drag to pick a colour."/>
                                    <Ellipse x:Name="ColourWheelMarker" Width="12" Height="12" IsHitTestVisible="False" Visibility="Collapsed"
                                             Stroke="White" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>

                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="#" Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="ColourHexBox" Width="100" Height="28" MaxLength="6"
                                                 CharacterCasing="Upper" TextChanged="ColourHex_Changed"
                                                 ToolTip="Six hex digits, for example C81E3C"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ColourSlotHint" Foreground="{DynamicResource DimTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" MaxWidth="140" Margin="0,8,0,0"
                                               Text="Click the circle to open the colour wheel."/>
                                    <StackPanel x:Name="BrightnessPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="Brightness" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                        <Slider x:Name="ColourValueSlider" Width="140" Minimum="0" Maximum="100" Value="100"
                                                HorizontalAlignment="Left" ValueChanged="ColourValue_Changed"
                                                ToolTip="How light or dark the picked colour is."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Each channel is a 0-255 slider with a live readout, so a
                                 colour can be dialled in without typing anything. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="ColourRedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                                        VerticalAlignment="Center" ValueChanged="ColourChannel_Changed"/>
                                <TextBlock x:Name="ColourRedValue" Grid.Row="0" Grid.Column="2" Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="ColourGreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                                        VerticalAlignment="Center" ValueChanged="ColourChannel_Changed"/>
                                <TextBlock x:Name="ColourGreenValue" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider x:Name="ColourBlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                                        VerticalAlignment="Center" ValueChanged="ColourChannel_Changed"/>
                                <TextBlock x:Name="ColourBlueValue" Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Apply" Width="92" Height="30" Click="ApplyCustomColour_Click"
                                        Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentSoftTextBrush}" BorderBrush="{DynamicResource AccentSoftTextBrush}"
                                        ToolTip="Use this colour for the selected element."/>
                                <Button Content="Reset to default" Width="140" Height="30" Margin="8,0,0,0" Click="ResetCustomColour_Click"
                                        ToolTip="Put the selected element back to the stock Casualties Hub colour."/>
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource DimTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Buttons, borders, and labels follow these four colours and stay readable whichever you pick."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Save stores the colours and text size you are using now. Apply puts a saved slot back." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <UniformGrid Columns="4" MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="CustomPreset1Name" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Apply" Tag="Custom1" Height="28" Margin="0,8,0,0" Click="ApplyUiPreset_Click"/>
                                <Button Content="Save" Tag="1" Height="28" Margin="0,6,0,0" Click="SaveUiPreset_Click" ToolTip="Overwrite this slot with your current colours and text size."/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="CustomPreset2Name" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Apply" Tag="Custom2" Height="28" Margin="0,8,0,0" Click="ApplyUiPreset_Click"/>
                                <Button Content="Save" Tag="2" Height="28" Margin="0,6,0,0" Click="SaveUiPreset_Click" ToolTip="Overwrite this slot with your current colours and text size."/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="CustomPreset3Name" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Apply" Tag="Custom3" Height="28" Margin="0,8,0,0" Click="ApplyUiPreset_Click"/>
                                <Button Content="Save" Tag="3" Height="28" Margin="0,6,0,0" Click="SaveUiPreset_Click" ToolTip="Overwrite this slot with your current colours and text size."/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                            <StackPanel>
                                <TextBlock x:Name="CustomPreset4Name" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Apply" Tag="Custom4" Height="28" Margin="0,8,0,0" Click="ApplyUiPreset_Click"/>
                                <Button Content="Save" Tag="4" Height="28" Margin="0,6,0,0" Click="SaveUiPreset_Click" ToolTip="Overwrite this slot with your current colours and text size."/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel><TextBlock Text="Nexus Premium" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Optional: sign in with your Nexus Mods account for direct Premium downloads." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Sign in with Nexus" Width="170" Click="SignInToNexus_Click" ToolTip="Opens your browser to sign in with Nexus Mods. With Premium, Download starts the file directly instead of opening the Nexus page."/><Button Content="Sign out" Width="100" Margin="10,0,0,0" Click="SignOutOfNexus_Click" ToolTip="Disconnect this PC from your Nexus Mods account. Downloads go back to opening the Nexus page in your browser."/></StackPanel><TextBlock x:Name="NexusSignInStatusText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel><TextBlock Text="Support logs" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Logs stay on this PC and describe Hub activity only. They do not include your API key, Discord token, IP address, or installation ID." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/><WrapPanel><Button Content="Open logs folder" Width="145" Margin="0,0,10,0" Click="OpenLogsFolder_Click" ToolTip="Open local Hub logs and diagnostic logs"/><Button Content="Open crash logs" Width="145" Margin="0,0,10,0" Click="OpenCrashLogs_Click" ToolTip="Open the folder containing the latest five Hub crash reports"/><Button Content="Create Log" Width="120" Click="CreateLog_Click" ToolTip="Create a diagnostic log containing the last 10 minutes of Hub activity"/></WrapPanel><TextBlock x:Name="StorageText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="7" Padding="18" BorderBrush="#7A2530" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Uninstall Casualties Hub" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Remove the Hub program files, your settings, protected assets, saved Nexus API key, or logs — choose exactly what to delete." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <Button Content="Uninstall..." Width="150" HorizontalAlignment="Left" Background="#A5182F" Foreground="{DynamicResource PrimaryTextBrush}" Click="Uninstall_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
