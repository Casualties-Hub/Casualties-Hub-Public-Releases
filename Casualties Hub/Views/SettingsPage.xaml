<Page x:Class="Casualties_Hub.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#2B2D31">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="820">
            <Border Background="#36393F" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Game location" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the Casualties Unknown game folder, BepInEx folder, or Plugins folder." Foreground="#C9CDD3" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <TextBox x:Name="GamePathBox" IsReadOnly="True" Background="#292B30" Foreground="White" BorderBrush="#555A63" Padding="8"/>
                    <Button Content="Change game folder" Width="170" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChangeFolder_Click"/>
                </StackPanel>
            </Border>

            <Border Background="#36393F" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Download inbox" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="New mod archives in this folder can be detected and offered for installation." Foreground="#C9CDD3" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <TextBox x:Name="DownloadPathBox" IsReadOnly="True" Background="#292B30" Foreground="White" BorderBrush="#555A63" Padding="8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Change download inbox" Width="185" Click="ChangeDownloadFolder_Click"/>
                        <CheckBox x:Name="DadipfBox" Content="Keep imported downloads" Foreground="White" Margin="16,4,0,0" ToolTip="Keep imported archives in the download inbox instead of moving them into Hub storage." Checked="DadipfBox_Changed" Unchecked="DadipfBox_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#36393F" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Accessibility" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Text size" Foreground="#C9CDD3" Margin="0,8,0,6"/>
                    <ComboBox x:Name="TextSizeBox" Width="180" HorizontalAlignment="Left" SelectionChanged="TextSizeBox_Changed"
                              Foreground="{DynamicResource ControlTextBrush}" Background="{DynamicResource ControlSurfaceBrush}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Small (12)" Tag="12"/>
                        <ComboBoxItem Content="Normal (14)" Tag="14"/>
                        <ComboBoxItem Content="Large (16)" Tag="16"/>
                        <ComboBoxItem Content="Extra Large (18)" Tag="18"/>
                        <ComboBoxItem Content="Maximum (20)" Tag="20"/>
                    </ComboBox>
                    <ToggleButton x:Name="EasterEggsToggle" Content="Easter Eggs" Width="115" Height="28" HorizontalAlignment="Left" Margin="0,12,0,0" Checked="EasterEggsToggle_Changed" Unchecked="EasterEggsToggle_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
                                <Setter Property="BorderBrush" Value="#555A63"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="UI colours" Foreground="#C9CDD3" Margin="0,16,0,4" FontWeight="SemiBold"/>
                    <TextBlock Text="Paste a #RRGGBB value for a quick change. Expand RGB only when you need fine control." Foreground="#A9AFB8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid MaxWidth="780">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Page text" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="PrimaryTextHexBox" Tag="PrimaryText" MaxLength="7" Width="95" HorizontalAlignment="Right" TextChanged="ThemeHexBox_TextChanged" ToolTip="Paste a hex colour such as #E8EAED"/></DockPanel>
                                <Expander Header="RGB sliders" Foreground="White" Margin="0,6,0,0">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Red" Foreground="#C9CDD3"/><Slider x:Name="PrimaryTextRedSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="PrimaryTextRedValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Green" Foreground="#C9CDD3"/><Slider x:Name="PrimaryTextGreenSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="PrimaryTextGreenValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Blue" Foreground="#C9CDD3"/><Slider x:Name="PrimaryTextBlueSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="PrimaryTextBlueValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Button text" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ButtonTextHexBox" Tag="ButtonText" MaxLength="7" Width="95" HorizontalAlignment="Right" TextChanged="ThemeHexBox_TextChanged" ToolTip="Paste a hex colour such as #141414"/></DockPanel>
                                <Expander Header="RGB sliders" Foreground="White" Margin="0,6,0,0">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Red" Foreground="#C9CDD3"/><Slider x:Name="ButtonTextRedSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonTextRedValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Green" Foreground="#C9CDD3"/><Slider x:Name="ButtonTextGreenSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonTextGreenValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Blue" Foreground="#C9CDD3"/><Slider x:Name="ButtonTextBlueSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonTextBlueValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Button background" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ButtonSurfaceHexBox" Tag="ButtonSurface" MaxLength="7" Width="95" HorizontalAlignment="Right" TextChanged="ThemeHexBox_TextChanged" ToolTip="Paste a hex colour such as #F5F5F5"/></DockPanel>
                                <Expander Header="RGB sliders" Foreground="White" Margin="0,6,0,0">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Red" Foreground="#C9CDD3"/><Slider x:Name="ButtonSurfaceRedSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonSurfaceRedValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Green" Foreground="#C9CDD3"/><Slider x:Name="ButtonSurfaceGreenSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonSurfaceGreenValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Blue" Foreground="#C9CDD3"/><Slider x:Name="ButtonSurfaceBlueSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="ButtonSurfaceBlueValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Accent" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="AccentHexBox" Tag="Accent" MaxLength="7" Width="95" HorizontalAlignment="Right" TextChanged="ThemeHexBox_TextChanged" ToolTip="Paste a hex colour such as #C21F32"/></DockPanel>
                                <Expander Header="RGB sliders" Foreground="White" Margin="0,6,0,0">
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Red" Foreground="#C9CDD3"/><Slider x:Name="AccentRedSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="AccentRedValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Green" Foreground="#C9CDD3"/><Slider x:Name="AccentGreenSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="AccentGreenValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Blue" Foreground="#C9CDD3"/><Slider x:Name="AccentBlueSlider" Minimum="0" Maximum="255" ValueChanged="ThemeColourSlider_Changed"/><TextBlock x:Name="AccentBlueValue" Foreground="#A9AFB8" HorizontalAlignment="Center"/></StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button Content="Restore default colours" Width="185" HorizontalAlignment="Left" Click="RestoreDefaultColours_Click" ToolTip="Restore the standard Casualties Hub colour set"/>
                </StackPanel>
            </Border>

            <Border Background="#36393F" CornerRadius="7" Padding="18" Margin="0,0,0,14">
                <StackPanel><TextBlock Text="Nexus Premium" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Optional: save your personal API key for direct mod downloads." Foreground="#C9CDD3" Margin="0,6,0,12"/><PasswordBox x:Name="NexusApiKeyBox" Background="#292B30" Foreground="White" BorderBrush="#555A63" Padding="8" ToolTip="Your personal Nexus API key"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Save Premium API key" Width="170" Click="SaveNexusApiKey_Click"/><Button Content="Clear key" Width="100" Margin="10,0,0,0" Click="ClearNexusApiKey_Click"/></StackPanel><TextBlock x:Name="NexusApiKeyStatusText" Foreground="#A9AFB8" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>

            <Border Background="#36393F" CornerRadius="7" Padding="18">
                <StackPanel><TextBlock Text="Support logs" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Logs stay on this PC and describe Hub activity only. They do not include your API key, Discord token, IP address, or installation ID." Foreground="#C9CDD3" Margin="0,6,0,12" TextWrapping="Wrap"/><WrapPanel><Button Content="Open logs folder" Width="145" Margin="0,0,10,0" Click="OpenLogsFolder_Click" ToolTip="Open local Hub logs and diagnostic logs"/><Button Content="Open crash logs" Width="145" Margin="0,0,10,0" Click="OpenCrashLogs_Click" ToolTip="Open the folder containing the latest five Hub crash reports"/><Button Content="Create Log" Width="120" Click="CreateLog_Click" ToolTip="Create a diagnostic log containing the last 10 minutes of Hub activity"/></WrapPanel><TextBlock x:Name="StorageText" Foreground="#A9AFB8" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
