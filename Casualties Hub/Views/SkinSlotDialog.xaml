<Window x:Class="Casualties_Hub.Views.SkinSlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose CustomSprites slot" Width="440" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="experimentCrus.png was found. Choose the CustomSprites slot this skin should use."
                   TextWrapping="Wrap"/>
        <ComboBox x:Name="SlotBox" Margin="0,14,0,6" DisplayMemberPath="Label" SelectionChanged="SlotBox_SelectionChanged"/>
        <TextBlock x:Name="SlotHint" TextWrapping="Wrap" Foreground="#B04A4A" MinHeight="34" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="Use slot" Width="100" IsDefault="True" Click="Replace_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
