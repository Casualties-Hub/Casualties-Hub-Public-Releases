<Page x:Class="Casualties_Hub.Views.DebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#2B2D31">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Live Hub activity, warnings, and errors. Logging continues even when this page is closed; use Copy Log or Open Hub Logs when reporting an issue."
                       Foreground="#C9CDD3" TextWrapping="Wrap"/>
            <TextBlock x:Name="LiveStatusText" Text="Live activity: On" Foreground="#67E480" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,12">
            <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" Foreground="White" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <Button Content="Refresh" Width="100" Margin="0,0,10,8" Click="Refresh_Click"/>
            <Button Content="Clear View" Width="100" Margin="0,0,10,8" Click="Clear_Click" ToolTip="Clears the in-app list; the next Hub activity creates a new entry."/>
            <Button Content="Copy Log" Width="100" Margin="0,0,10,8" Click="CopyLog_Click" ToolTip="Copy current live console text for a Discord support report."/>
            <Button Content="Open Current Log" Width="135" Margin="0,0,10,8" Click="OpenCurrentLog_Click"/>
            <Button Content="Open BepInEx crash log" Width="180" Margin="0,0,10,8" Click="OpenCrashLog_Click" ToolTip="Opens BepInEx LogOut.log or LogOutput.log in Notepad"/>
            <Button Content="Create Crash Report" Width="145" Margin="0,0,10,8" Click="CreateCrashReport_Click"/>
            <Button Content="Open Hub Logs" Width="120" Margin="0,0,10,8" Click="OpenHubLogs_Click"/>
        </WrapPanel>

        <ListBox x:Name="LogList" Grid.Row="2" Background="#18191C" Foreground="#D5D9E0"
                 FontFamily="Consolas" FontSize="12" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Page>
