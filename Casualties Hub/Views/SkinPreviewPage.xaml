<Page x:Class="Casualties_Hub.Views.SkinPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:Casualties_Hub.Views"
      Background="#2B2D31">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#36393F" CornerRadius="6" Padding="12" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Detected skin slots" Foreground="White" FontWeight="Bold" Margin="2,0,0,10"/>

                <ListBox x:Name="SlotList" Grid.Row="1" Background="#2B2D31" Foreground="White" BorderThickness="0"
                         SelectionChanged="SlotList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}" ToolTip="{Binding StatusTooltip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- A slot missing required art is called out in red so a bad install is obvious. -->
                                            <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Without this the tooltip only shows over the text, not the whole row. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock x:Name="EmptySlotsMessage" Grid.Row="1" Foreground="#8A8F98" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="4" Visibility="Collapsed"/>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Refresh" Height="30" Margin="0,0,0,6" Click="Refresh_Click"/>
                    <Button Content="Open CustomSprites folder" Height="30" Click="OpenFolder_Click"/>
                    <Separator Margin="0,12,0,10" Background="#4A4D53"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#C9CDD3" FontSize="11">
                        <Run Text="Looking for more skins?"/>
                        <LineBreak/>
                        <Hyperlink NavigateUri="https://skin.cat-bot.de/" Foreground="#7FA9E8"
                                   RequestNavigate="SkinSite_RequestNavigate"
                                   ToolTip="skin.cat-bot.de, the main community site where most Casualties Unknown skins are uploaded">
                            Browse skin.cat-bot.de
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <views:SkinPreviewControl x:Name="Preview" Grid.Column="1"/>
    </Grid>
</Page>
