<Window x:Class="Casualties_Hub.Views.UpdateCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reclaim space from old updates"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#2B2D31">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reclaim space from old updates" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#DCE0E5"
                   Text="Casualties Hub found leftover downloaded/unzipped files from past updates in your Temp folder. They are no longer needed."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,6">
            <TextBlock Text="Found folders" Foreground="#C9CDD3" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="SelectAllButton" Content="Select all" Width="90" Height="24" Margin="12,0,0,0" Click="SelectAllButton_Click"/>
            <Button x:Name="SelectNoneButton" Content="Select none" Width="100" Height="24" Margin="8,0,0,0" Click="SelectNoneButton_Click"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#292B30" BorderBrush="#555A63" BorderThickness="1" CornerRadius="5" Padding="12" MaxHeight="280">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="4" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#A9AFB8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Skip" Width="100" Height="34" Margin="0,0,10,0" IsCancel="True" Click="Skip_Click"/>
            <Button x:Name="DeleteButton" Content="Delete selected" Width="150" Height="34" Background="#C21F32" Foreground="White" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>
