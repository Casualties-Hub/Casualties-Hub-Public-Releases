<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Casualties_Hub.Views.DashboardPage">

  <DockPanel>

    <Border x:Name="GameFolderCard" DockPanel.Dock="Top" Classes="card"
            BorderBrush="{DynamicResource WarningBrush}" Margin="0,0,0,14" IsVisible="False">
      <StackPanel Spacing="8">
        <TextBlock Classes="heading" Text="No game folder set"/>
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The Hub cannot tell what you have installed until it knows where Casualties Unknown lives."/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="DetectButton" Classes="accent" Content="Detect automatically"/>
          <Button x:Name="ChooseFolderButton" Content="Choose folder..."/>
          <Button x:Name="OpenSettingsButton" Content="Open Settings"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="heading" Text="Community mods"/>
            <TextBlock x:Name="SummaryText" Classes="dim"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <CheckBox x:Name="AdultContentBox" Content="18+"
                      ToolTip.Tip="Include mods flagged as adult content on Nexus."/>
            <!-- Segmented tiles/list switch. -->
            <Border Margin="4,0" CornerRadius="6" ClipToBounds="True" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource InsetBrush}">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TilesViewButton" Classes="segment" ToolTip.Tip="Show as tiles">
                  <mi:MaterialIcon Kind="ViewGrid" Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Border Width="1" Background="{DynamicResource ControlBorderBrush}"/>
                <Button x:Name="ListViewButton" Classes="segment" ToolTip.Tip="Show as a list">
                  <mi:MaterialIcon Kind="ViewList" Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
              </StackPanel>
            </Border>
            <Button x:Name="RefreshButton" Content="Refresh"/>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,0"
                   Watermark="Search by name, author or description"/>
          <ComboBox x:Name="FilterBox" Grid.Column="1" Margin="0,0,8,0" MinWidth="165"/>
          <ComboBox x:Name="SortBox" Grid.Column="2" MinWidth="165"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,14,0,0" Padding="12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="PrevButton" Grid.Column="0" Content="Previous"/>
        <TextBlock x:Name="PageText" Grid.Column="1" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button x:Name="NextButton" Grid.Column="2" Content="Next"/>
      </Grid>
    </Border>

    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Classes="muted"
               TextWrapping="Wrap" Margin="2,0,0,10" IsVisible="False"/>

    <Panel>
    <ScrollViewer x:Name="ModScroller">
      <StackPanel>

      <!-- List view: one compact row per mod, description folds out beneath on click. -->
      <ItemsControl x:Name="ModRows" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="10" Margin="0,0,14,6" Padding="8"
                    Background="{DynamicResource CardBrush}" BorderThickness="1"
                    BorderBrush="{Binding CardBorderBrush}" Cursor="Hand"
                    Tag="{Binding}" PointerPressed="OnCardPressed">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding DashboardActionLabel}" Tag="{Binding}" Click="OnAction"/>
                  <MenuItem Header="{Binding DetailsMenuLabel}" Tag="{Binding}" Click="OnToggleDetails"/>
                  <Separator/>
                  <MenuItem Header="View mod page on Nexus" Tag="{Binding}" Click="OnOpenNexus"/>
                  <MenuItem Header="Copy Nexus link" Tag="{Binding}" Click="OnCopyNexusLink"/>
                </ContextMenu>
              </Border.ContextMenu>
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                  <!-- The small thumbnail gives way to the large image below when the row is open. -->
                  <Border Grid.Column="0" Width="56" Height="40" CornerRadius="6" ClipToBounds="True"
                          Margin="0,0,12,0" Background="{DynamicResource ChromeBrush}"
                          IsVisible="{Binding IsCollapsed}">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                  </Border>

                  <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Spacing="2">
                    <!-- Collapsed: name and chip, excerpt beneath. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCollapsed}">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <Border IsVisible="{Binding HasStatusChip}" CornerRadius="999" Padding="7,1"
                              Background="{DynamicResource InsetBrush}" BorderThickness="1"
                              BorderBrush="{Binding StatusBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusChipLabel}" FontSize="11" Foreground="{Binding StatusBrush}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding RowSubtitle}" Classes="muted" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsCollapsed}"/>
                    <!-- Expanded: a larger heading with author and version alongside. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDescriptionExpanded}">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding AuthorAndVersion}" Classes="muted" VerticalAlignment="Center"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      <Border IsVisible="{Binding HasStatusChip}" CornerRadius="999" Padding="7,1"
                              Background="{DynamicResource InsetBrush}" BorderThickness="1"
                              BorderBrush="{Binding StatusBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusChipLabel}" FontSize="11" Foreground="{Binding StatusBrush}"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding TotalDownloadsLabel}">
                      <mi:MaterialIcon Kind="Download" Width="15" Height="15" Foreground="{DynamicResource MutedTextBrush}"/>
                      <TextBlock Text="{Binding CompactDownloads}" Classes="muted" MinWidth="40"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding EndorsementsLabel}">
                      <mi:MaterialIcon Kind="ThumbUp" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}"/>
                      <TextBlock Text="{Binding CompactEndorsements}" Classes="muted" MinWidth="36"/>
                    </StackPanel>
                  </StackPanel>

                  <Button Grid.Column="3" Classes="icon" Tag="{Binding}" Click="OnOpenNexus"
                          VerticalAlignment="Center" ToolTip.Tip="View mod page on Nexus">
                    <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <Button Grid.Column="4" Content="{Binding DashboardActionLabel}" Tag="{Binding}" Click="OnAction"
                          Height="30" MinWidth="130" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid IsVisible="{Binding IsDescriptionExpanded}" ColumnDefinitions="Auto,*" Margin="0,10,8,2">
                  <Border Grid.Column="0" Width="220" Height="140" CornerRadius="8" ClipToBounds="True"
                          Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource ChromeBrush}">
                    <Panel>
                      <TextBlock Text="No image" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding RenderedDescription}" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock Text="{Binding DependenciesLabel}" Foreground="#5DB8FF" IsVisible="{Binding HasDependencies}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Tile view: the artwork fills the tile; clicking opens the detail panel above the grid. -->
      <ItemsControl x:Name="ModList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="224" Height="168" CornerRadius="12" Margin="0,0,14,14"
                    Background="{DynamicResource ChromeBrush}" BorderThickness="1"
                    BorderBrush="{Binding CardBorderBrush}" Cursor="Hand"
                    Tag="{Binding}" PointerPressed="OnCardPressed">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding DashboardActionLabel}" Tag="{Binding}" Click="OnAction"/>
                  <MenuItem Header="{Binding DetailsMenuLabel}" Tag="{Binding}" Click="OnToggleDetails"/>
                  <Separator/>
                  <MenuItem Header="View mod page on Nexus" Tag="{Binding}" Click="OnOpenNexus"/>
                  <MenuItem Header="Copy Nexus link" Tag="{Binding}" Click="OnCopyNexusLink"/>
                </ContextMenu>
              </Border.ContextMenu>
              <!-- Clip to the rounded inner edge, or the square artwork paints over the corners. -->
              <Panel>
                <Panel.Clip>
                  <RectangleGeometry Rect="0,0,222,166" RadiusX="11" RadiusY="11"/>
                </Panel.Clip>
                <TextBlock Text="No image" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>

                <Border IsVisible="{Binding HasStatusChip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8" CornerRadius="999" Padding="7,2"
                        Background="{DynamicResource InsetBrush}" BorderThickness="1" BorderBrush="{Binding StatusBrush}">
                  <TextBlock Text="{Binding StatusChipLabel}" FontSize="11" Foreground="{Binding StatusBrush}"/>
                </Border>

                <Border VerticalAlignment="Bottom" Background="{DynamicResource ChromeBrush}" Padding="10,7">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TileSubtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>

              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </StackPanel>
    </ScrollViewer>

      <!-- Tile detail: floats over the grid so the list keeps its scroll position. The backdrop is
           opaque so nothing shows through the rounded corners of the panel. Clicking the
           dimmed backdrop closes it. -->
      <Border x:Name="TileDetailBackdrop" IsVisible="False" Background="{DynamicResource WindowBackgroundBrush}"
              PointerPressed="OnTileDetailBackdropPressed"/>
      <Border x:Name="TileDetail" IsVisible="False" CornerRadius="10" Padding="10"
              Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{Binding CardBorderBrush}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding AuthorAndVersion}" Classes="muted" VerticalAlignment="Center"
                         Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
              <Border IsVisible="{Binding HasStatusChip}" CornerRadius="999" Padding="7,1"
                      Background="{DynamicResource InsetBrush}" BorderThickness="1"
                      BorderBrush="{Binding StatusBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusChipLabel}" FontSize="11" Foreground="{Binding StatusBrush}"/>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding TotalDownloadsLabel}">
                <mi:MaterialIcon Kind="Download" Width="15" Height="15" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding CompactDownloads}" Classes="muted" MinWidth="40"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding EndorsementsLabel}">
                <mi:MaterialIcon Kind="ThumbUp" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding CompactEndorsements}" Classes="muted" MinWidth="36"/>
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="icon" Tag="{Binding}" Click="OnOpenNexus"
                    VerticalAlignment="Center" ToolTip.Tip="View mod page on Nexus">
              <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
            <Button Grid.Column="3" Content="{Binding DashboardActionLabel}" Tag="{Binding}" Click="OnAction"
                    Height="30" MinWidth="130" Margin="6,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="4" x:Name="TileDetailCloseButton" Classes="icon" Margin="6,0,0,0"
                    VerticalAlignment="Center" ToolTip.Tip="Close">
              <mi:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <Border Grid.Column="0" Width="220" Height="140" CornerRadius="8" ClipToBounds="True"
                    Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource ChromeBrush}">
              <Panel>
                <TextBlock Text="No image" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
              </Panel>
            </Border>
            <ScrollViewer x:Name="TileDetailScroller" Grid.Column="1">
              <StackPanel Spacing="6" Margin="0,0,8,0">
                <TextBlock Text="{Binding RenderedDescription}" TextWrapping="Wrap" LineHeight="18"/>
                <TextBlock Text="{Binding DependenciesLabel}" Foreground="#5DB8FF" IsVisible="{Binding HasDependencies}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

    </Panel>

  </DockPanel>

</UserControl>
