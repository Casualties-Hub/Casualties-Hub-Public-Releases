<Window x:Class="Casualties_Hub.Views.OnlineServicesChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Casualties Hub Online Services"
        Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#2B2D31">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Online services are optional" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#DCE0E5"
                   Text="Casualties Hub can connect to its update service to show announcements, maintenance status, and available Hub updates. This is off by default."/>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#A9AFB8"
                   Text="Nexus mod metadata still requires an internet connection when you browse or refresh it. You can change this online-services choice later in Hub Home."/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Keep offline" Width="132" Height="34" Margin="0,0,10,0" IsCancel="True" Click="KeepOffline_Click"/>
            <Button Content="Enable online services" Width="176" Height="34" Background="#C21F32" Foreground="White" IsDefault="True" Click="EnableOnlineServices_Click"/>
        </StackPanel>
    </Grid>
</Window>
